# ---------------------------------------------------------------------------
# StockFlow API environment
# Copy to `apps/api/.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. StockFlow requires PostgreSQL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockflow?schema=public"

# Secret used to sign session JWTs. Must be at least 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
NODE_ENV="development"
PORT="4000"

# Session cookie
COOKIE_NAME="stockflow_token"
# Set to "true" when serving over HTTPS.
COOKIE_SECURE="false"

# bcrypt work factor (10-15).
BCRYPT_ROUNDS="12"

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN="http://localhost:3000"
